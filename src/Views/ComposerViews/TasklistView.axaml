<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:vm="using:Violet.ViewModels"
	x:Class="Violet.Views.TasklistView"
	x:DataType="vm:TasklistViewModel"
	VerticalAlignment="Stretch"
	HorizontalAlignment="Stretch"
	Margin="25"
>
	<StackPanel Spacing="10" Margin="15">

		<Border CornerRadius="10" 
		Background="{DynamicResource MidgroundBrush}"
		>
			<TextBlock Classes="standardTitle" HorizontalAlignment="Center">VIOLET</TextBlock>
		</Border>

		<Button Command="{Binding AddTaskCommand}">
			Add
		</Button>

		<ItemsControl ItemsSource="{Binding TaskViewModels}" />

    </StackPanel>
		
</UserControl>