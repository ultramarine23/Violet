<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:components="using:Violet.Views.Components"
	x:Class="Violet.Views.PageViews.TasksView"
	VerticalAlignment="Stretch"
	HorizontalAlignment="Stretch"
	Margin="25"
>
	<StackPanel Spacing="10">

		<Border Padding="15" CornerRadius="10" 
		Background="{DynamicResource MidgroundBrush}">
			<TextBlock Classes="standardHeader" HorizontalAlignment="Center" Text="VIOLET" />
		</Border>

		<Grid Margin="25 10" ColumnDefinitions="120, *, 2*"
		RowDefinitions="Auto, Auto, Auto" RowSpacing="5"
		>
			<TextBlock Grid.Column="0" Grid.Row="0" VerticalAlignment="Center">Celsius</TextBlock>
			<TextBox Grid.Column="1" Grid.Row="0">0</TextBox>
			<TextBlock Grid.Column="0" Grid.Row="1" VerticalAlignment="Center">Fahrenheit</TextBlock>
			<TextBox Grid.Column="1" Grid.Row="1">0</TextBox>
		</Grid>

		<components:TaskCard />
		<components:TaskCard />
		<components:TaskCard />

    </StackPanel>
		
</UserControl>