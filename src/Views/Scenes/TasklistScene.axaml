<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:vm="using:Violet.ViewModels"

	x:Class="Violet.Views.TasklistScene"
	x:DataType="vm:TasklistSceneModel"

	VerticalAlignment="Stretch"
	HorizontalAlignment="Stretch"
	Margin="25"
>
	<StackPanel Spacing="10" Margin="15">

		<Border CornerRadius="10" Background="{DynamicResource MidgroundBrush}">
			<TextBlock Classes="standardTitle" HorizontalAlignment="Center" Text="VIOLET" />
		</Border>

		<Button Command="{Binding AddTaskCommand}" Content="Add" />
		<ItemsControl ItemsSource="{Binding TaskViewModels}" />

    </StackPanel>
		
</UserControl>