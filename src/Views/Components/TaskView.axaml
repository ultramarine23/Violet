<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:vm="using:Violet.ViewModels"
	x:Class="Violet.Views.TaskView"
	x:DataType="vm:TaskViewModel"
	VerticalAlignment="Stretch"
	HorizontalAlignment="Stretch"
>
	
    <Border
        Background="{DynamicResource MidgroundBrush}"
        CornerRadius="4"
        Padding="16"
	>
        <CheckBox>
			<StackPanel VerticalAlignment="Center" Spacing="0">
				<Border Classes="bodyContainer">
					<TextBlock Classes="standardBody" Text="{Binding Description}" />
				</Border>
				<Border Classes="bodyContainer">
					<TextBlock Classes="standardBody" Text="aaaaaa" />
				</Border>
        	</StackPanel>
		</CheckBox>

    </Border>
</UserControl>