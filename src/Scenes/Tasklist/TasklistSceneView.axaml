<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:vm="using:Violet.ViewModels"
	xmlns:views="using:Violet.Views"

	x:Class="Violet.Views.TasklistSceneView"
	x:DataType="vm:TasklistSceneViewModel"

	VerticalAlignment="Stretch"
	HorizontalAlignment="Stretch"
	Margin="25"
>
	<StackPanel Spacing="10" Margin="15">

		<views:TaskAdderView DataContext="{Binding TaskAdderVM}"/>
		<views:TaskInspectorView DataContext="{Binding TaskInspectorVM}" />

    </StackPanel>
		
</UserControl>