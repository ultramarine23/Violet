<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:vm="using:Violet.ViewModels"
	x:Class="Violet.Views.TaskAdderView"
	x:DataType="vm:TaskAdderViewModel"
	VerticalAlignment="Stretch"
	HorizontalAlignment="Stretch"
>
    <Border
        Background="{DynamicResource MidgroundBrush}"
        CornerRadius="4"
        VerticalAlignment="Stretch"
        HorizontalAlignment="Stretch"
	>
        <Grid ColumnDefinitions="* 48" RowDefinitions="32 32" ColumnSpacing="5" RowSpacing="5" Margin="10">
            <TextBox
                Classes="purpleHighlight"
                Grid.Column="0"
                Grid.Row="0"
                PlaceholderText="Enter task description..."
                Text="{Binding NewDescription}"
                VerticalAlignment="Stretch"
                HorizontalAlignment="Stretch"
                VerticalContentAlignment="Center"
                TabIndex="10"
            />

            <Button
                Grid.Column="1"
                Grid.Row="0"
                VerticalAlignment="Stretch"
                HorizontalAlignment="Stretch"
                Content="{SvgImage /Assets/Icons/ic--outline-add.svg}"
                Command="{Binding AddTaskCommand}"
            />

            <Grid ColumnDefinitions="* * * *" Grid.Column="0" Grid.Row="1" ColumnSpacing="5">
                <ContentControl
                    Grid.Column="0"
                    VerticalAlignment="Stretch"
                    HorizontalAlignment="Stretch"
                    Content="{Binding DateSelectorVM}"
                />

                <!-- <TimePicker
                    Grid.Column="1"
                    VerticalAlignment="Stretch"
                    HorizontalAlignment="Stretch"
                    SelectedTime="{Binding NewTimeDue}"
                    MinuteIncrement="30"
                /> -->

                <ContentControl
                    Grid.Column="1"
                    VerticalAlignment="Stretch"
                    HorizontalAlignment="Stretch"
                    Content="{Binding TimeSelectorVM}"
                />

                <ContentControl
                    Grid.Column="3"
                    VerticalAlignment="Stretch"
                    HorizontalAlignment="Stretch"
                    Content="{Binding TimespanSelectorVM}"
                />

            </Grid>
        </Grid>
    </Border>

	
</UserControl>