<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:vm="using:Violet.ViewModels"
	x:Class="Violet.Views.TaskView"
	x:DataType="vm:TaskViewModel"
	VerticalAlignment="Stretch"
	HorizontalAlignment="Stretch"
>
    <Border
        Background="{DynamicResource ElevatedBrush}"
        CornerRadius="4"
        Padding="15"
		Margin="0 5"
	>
        <Grid ColumnDefinitions="32 *" RowDefinitions="Auto Auto">
			<!-- {r} CHECKBOX -->
			<CheckBox Grid.Column="0" Grid.RowSpan="2" />


			<!-- {g} HEADER (DESCRIPTION) -->
			<Border Grid.Column="1" Grid.Row="0">
				<TextBlock Classes="standardBody" Text="{Binding Description}" />
			</Border>


			<!-- {v} SUBTITLE -->
			<StackPanel Orientation="Horizontal" Grid.Column="1" Grid.Row="1">
				<TextBlock Classes="muteBody" Text="due on: " />
				<TextBlock Classes="muteBody" Text="{Binding DateDueString}" />
			</StackPanel>

			
		</Grid>
    </Border>

	
</UserControl>