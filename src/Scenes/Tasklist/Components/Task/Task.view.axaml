<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:vm="using:Violet.ViewModels"
	x:Class="Violet.Views.TaskView"
	x:DataType="vm:TaskViewModel"
	VerticalAlignment="Center"
	HorizontalAlignment="Stretch"
	KeyboardNavigation.TabNavigation="Cycle"
>
	<!-- STYLES {gray} -->
    <UserControl.Styles>
		<Style Selector="Button.deleteButton">
            <Setter Property="Background" Value="{DynamicResource ElevatedBrush}"/>
            <Setter Property="Margin" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HorizontalAlignment" Value="Center" />

            <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource RedBrush}" />
            </Style>

            <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource DarkRedBrush}" />
            </Style>

            <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource DarkRedBrush}" />
            </Style>
        </Style>

		<Style Selector="Button.editButton">
            <Setter Property="Background" Value="{DynamicResource ElevatedBrush}"/>
            <Setter Property="Margin" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HorizontalAlignment" Value="Center" />

            <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource YellowBrush}" />
            </Style>

            <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource DarkYellowBrush}" />
            </Style>

            <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource DarkYellowBrush}" />
            </Style>
        </Style>

		<Style Selector="Button.confirmButton">
            <Setter Property="Background" Value="{DynamicResource ElevatedBrush}"/>
            <Setter Property="Margin" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HorizontalAlignment" Value="Center" />

            <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource GreenBrush}" />
            </Style>

            <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource DarkGreenBrush}" />
            </Style>

            <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource DarkGreenBrush}" />
            </Style>
        </Style>
	</UserControl.Styles>


	<Border
        Background="{DynamicResource ForegroundBrush}"
        CornerRadius="4"
        Padding="5"
		Margin="0 5"
		
	>	
		<Grid ColumnDefinitions="25 * 48" RowDefinitions="Auto" ColumnSpacing="5" Margin="5">
			<!-- {r} CHECKBOX -->
			<CheckBox 
				Name="CompletedCheckbox"
				Grid.Column="0" 
				Grid.Row="0"
				VerticalAlignment="Top"
				HorizontalAlignment="Left"
				Command="{Binding ToggleCompletedStateCommand}"
				CommandParameter="{Binding #CompletedCheckbox.IsChecked}"
				IsChecked="{Binding IsMarkedDone, Mode=OneWay}"
			/>


			<!-- {g} HEADER + SUBTITLE -->
			<StackPanel Grid.Column="1" Grid.Row="0" Spacing="2">
				<Border>
					<TextBox
						Name="Description"
						Classes="standardBox"
						VerticalAlignment="Top"
						Margin="0 6"
						Text="{Binding Description}"
						IsReadOnly="{Binding ReadMode}"
						IsHitTestVisible="{Binding !ReadMode}"
						Focusable="{Binding !ReadMode}"
					/>
				</Border>

				<StackPanel Orientation="Horizontal" Grid.Column="1" Grid.Row="1">
					<Svg 
						Path="/Assets/Icons/ic--outline-calendar-month.svg"
						Width="15"
						Height="15"
						HorizontalAlignment="Center"
					/>
					<TextBlock 
						Classes="muteBody" 
						Text="{Binding DateDueString}"
						HorizontalAlignment="Center"
						Padding="5 0"
					/>
				</StackPanel>

				<StackPanel Orientation="Horizontal" Grid.Column="1" Grid.Row="1">
					<Svg 
						Path="/Assets/Icons/ic--outline-access-time.svg"
						Width="15"
						Height="15"
						HorizontalAlignment="Center"
					/>
					<TextBlock 
						Classes="muteBody" 
						Text="{Binding TimeDueString}"
						HorizontalAlignment="Center"
						Padding="5 0"
					/>
				</StackPanel>

				<StackPanel Orientation="Horizontal" Grid.Column="1" Grid.Row="1">
					<Svg 
						Path="/Assets/Icons/ic--outline-hourglass-top.svg"
						Width="15"
						Height="15"
						HorizontalAlignment="Center"
					/>
					<TextBlock 
						Classes="muteBody" 
						Text="{Binding EstTimeString}"
						HorizontalAlignment="Center"
						Padding="5 0"
					/>
				</StackPanel>
			</StackPanel>
			
			
			<!-- {b} BUTTONS PANEL -->	
			<StackPanel Grid.Column="2" Grid.RowSpan="2" Spacing="5" VerticalAlignment="Top">
				<Button
					Classes="editButton"
					HorizontalAlignment="Stretch"
					Command="{Binding StartEditCommand}"
					IsVisible="{Binding ReadMode}"
				>
					<Svg 
						Path="/Assets/Icons/ic--outline-edit.svg"
						Width="20"
						Height="20"
						HorizontalAlignment="Center"
					/>
				</Button>

				<Button
					Classes="confirmButton"
					HorizontalAlignment="Stretch"
					Command="{Binding EndEditCommand}"
					IsVisible="{Binding !ReadMode}"
				>
					<Svg 
						Path="/Assets/Icons/ic--outline-check.svg"
						Width="20"
						Height="20"
						HorizontalAlignment="Center"
					/>
				</Button>

				<Button
					Classes="deleteButton"
					HorizontalAlignment="Stretch"
					Command="{Binding DeleteSelfCommand}"
				>
					<Svg 
						Path="/Assets/Icons/ic--outline-delete.svg"
						Width="20"
						Height="20"
						HorizontalAlignment="Center"
					/>
				</Button>
			</StackPanel>		


		</Grid>
    </Border>

	
</UserControl>