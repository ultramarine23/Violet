<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:vm="using:Violet.ViewModels"
	x:Class="Violet.Views.DateSelectorView"
	x:DataType="vm:DateSelectorViewModel"
	VerticalAlignment="Stretch"
	HorizontalAlignment="Stretch"
>

	<Grid>
		<TextBox
			Classes="purpleHighlight"
			VerticalAlignment="Stretch"
			HorizontalAlignment="Stretch"
			TextAlignment="Center"
			Text="{Binding DateSelectedString}"
			IsReadOnly="True"
			CornerRadius="4"
			CaretBrush="{DynamicResource AccentPressedBrush}"		
			InnerRightContent="{SvgImage /Assets/Icons/ic--outline-unfold-more.svg}"
		/>

		<Button
			ZIndex="2"
			VerticalAlignment="Stretch"
			HorizontalAlignment="Stretch"
			Foreground="Transparent"
			Background="Transparent"
			Opacity="0.5"
			BorderThickness="0"
			Focusable="False"
		/>
	</Grid>

	
</UserControl>