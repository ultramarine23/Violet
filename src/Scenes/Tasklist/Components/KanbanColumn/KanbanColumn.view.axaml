<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:vm="using:Violet.ViewModels"
	x:Class="Violet.Views.KanbanColumnView"
	x:DataType="vm:KanbanColumnViewModel"
	VerticalAlignment="Stretch"
	HorizontalAlignment="Stretch"
>
    <Border
        Background="{DynamicResource MidgroundBrush}"
        CornerRadius="4"
        Padding="10"
	>
        <StackPanel>
            <TextBlock
                Classes="standardBody"
                FontSize="14"
                FontWeight="Bold"
                Margin="5"
                Text="{Binding ColumnName}"
            />
            <ItemsControl ItemsSource="{Binding TaskViewModels}" HorizontalAlignment="Stretch" />
        </StackPanel>
    </Border>

	
</UserControl>